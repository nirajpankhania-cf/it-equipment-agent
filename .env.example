# Copy to .env and fill in. .env is git-ignored; never commit it.
# The anthropic SDK's AnthropicFoundry client reads the first three itself.
ANTHROPIC_FOUNDRY_API_KEY=
# Resource name, e.g. my-resource for https://my-resource.services.ai.azure.com/anthropic/
ANTHROPIC_FOUNDRY_RESOURCE=
# Alternative to the resource name: the full base URL. Set one or the other, not both.
ANTHROPIC_FOUNDRY_BASE_URL=
# Foundry deployment name passed as the model. Defaults to claude-fable-5-2 if empty.
# Any value here needs a matching [models."<name>"] entry in pricing.toml, or the agent
# refuses to start, so every model call can be costed.
MODEL=
